# Environment Configuration Template
# Copy this file to .env.local and update the values

# Application Environment
VITE_APP_ENV=development
VITE_APP_NAME="Template Shadcn"
VITE_APP_VERSION="2.0.0"
VITE_APP_DESCRIPTION="Modern React template with TypeScript, Vite, and Shadcn/ui"

# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=10000

# Authentication (if needed)
VITE_AUTH_ENABLED=true
VITE_JWT_SECRET=your-jwt-secret-key

# Feature Flags
VITE_FEATURE_FLAGS_ENABLED=true
VITE_FEATURE_V2_DEMO=true

# Theme Configuration
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true

# Development Tools
VITE_ENABLE_DEVTOOLS=true
VITE_LOG_LEVEL=debug

# External Services (optional)
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_SENTRY_DSN=
# VITE_HOTJAR_ID=

# Build Configuration
VITE_BUILD_SOURCEMAP=true
VITE_BUILD_MINIFY=true

# Staging Environment Variables
# VITE_APP_ENV=staging
# VITE_API_URL=https://staging-api.yourapp.com

# Production Environment Variables
# VITE_APP_ENV=production
# VITE_API_URL=https://api.yourapp.com
# VITE_BUILD_SOURCEMAP=false
